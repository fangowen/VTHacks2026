# Copy (don't move) this file to server/.env and fill in the values:
#   cp .env.example .env
# Never commit .env — it holds live keys.

# --- Gemini (https://aistudio.google.com/apikey) ---
GEMINI_API_KEY=your-gemini-api-key
# Measured on this app: 3.5-flash-lite ~5.6s, 3.6-flash ~8.8s, 3.8-flash ~30s (too slow to speak)
GEMINI_MODEL=gemini-3.5-flash-lite
# Flash replies take roughly 7-15s (longer for non-Latin scripts); don't go below ~20000
GEMINI_TIMEOUT_MS=30000

# --- ElevenLabs (https://elevenlabs.io/app/settings/api-keys) ---
ELEVENLABS_API_KEY=your-elevenlabs-api-key
# Voice id from https://elevenlabs.io/app/voice-library (copy "Voice ID")
ELEVENLABS_VOICE_ID=your-voice-id
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128
ELEVENLABS_TIMEOUT_MS=15000
# Voice input (speech-to-text)
ELEVENLABS_STT_MODEL_ID=scribe_v2
ELEVENLABS_STT_TIMEOUT_MS=30000

# --- Server ---
PORT=8787
# Comma-separated list of frontend origins allowed to call this API.
# This must match the port you serve the frontend on:
#   python3 -m http.server 8000  -> http://localhost:8000
#   npx serve                    -> http://localhost:3000
# localhost / 127.0.0.1 / [::1] on a listed port are all accepted automatically.
ALLOWED_ORIGINS=http://localhost:8000,http://localhost:3000
# Enforce the list above. Loopback aliases on those exact ports are still added automatically.
CORS_STRICT=true
MAX_MESSAGE_CHARS=1000
MAX_HISTORY_TURNS=10
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=20
